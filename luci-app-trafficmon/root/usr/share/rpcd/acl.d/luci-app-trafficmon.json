{
  "luci-app-trafficmon": {
    "description": "Read trafficmon data and edit its UCI configuration",
    "read": {
      "file": { "/usr/libexec/trafficmon-luci *": [ "exec" ] },
      "uci": [ "trafficmon" ]
    },
    "write": {
      "file": { "/usr/libexec/trafficmon-luci-archive *": [ "exec" ] },
      "uci": [ "trafficmon" ]
    }
  }
}
