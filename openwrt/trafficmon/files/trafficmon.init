#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1
extra_command "prefix_signature" "Print the canonical local network signature"

. /lib/functions.sh
. /lib/functions/network.sh
. /usr/lib/trafficmon/network-signature.sh

validate_uint()
{
	local name="$1"
	local value="$2"
	local minimum="$3"
	local maximum="$4"
	case "$value" in
		''|*[!0-9]*) logger -t trafficmon "invalid $name: $value"; return 1 ;;
	esac
	[ "$value" -ge "$minimum" ] 2>/dev/null && [ "$value" -le "$maximum" ] 2>/dev/null || {
		logger -t trafficmon "invalid $name: $value"
		return 1
	}
}

validate_path()
{
	local name="$1"
	local value="$2"
	case "$value" in
		/*) return 0 ;;
		*) logger -t trafficmon "$name must be an absolute path: $value"; return 1 ;;
	esac
}

append_subnets()
{
	local values="$1"
	local subnet
	for subnet in $values; do
		append TM_LOCAL_SUBNETS "$subnet"
	done
}

resolve_local_network()
{
	local value="$1"
	local subnets4 subnets6 device
	case "$value" in
		*/*)
			/usr/sbin/trafficmon --validate-subnet "$value" >/dev/null 2>&1 || {
				logger -t trafficmon "invalid local subnet: $value"
				TM_CONFIG_ERROR=1
				return
			}
			append TM_LOCAL_SUBNETS "$value"
			return 0
			;;
	esac
	ubus -S call "network.interface.$value" status >/dev/null 2>&1 || {
		logger -t trafficmon "unknown logical network: $value"
		TM_CONFIG_ERROR=1
		return
	}
	network_get_subnets subnets4 "$value"
	network_get_subnets6 subnets6 "$value"
	if [ -z "$subnets4$subnets6" ]; then
		logger -t trafficmon "logical network has no IPv4 or IPv6 prefix: $value"
		TM_CONFIG_ERROR=1
		return
	fi
	append_subnets "$subnets4"
	append_subnets "$subnets6"
	network_get_device device "$value"
	if [ -z "$device" ]; then
		logger -t trafficmon "logical network has no local device: $value"
		TM_CONFIG_ERROR=1
		return
	fi
	append_local_interface "$device"
}

resolve_prefix_signature()
{
	TM_LOCAL_SUBNETS=
	TM_LOCAL_INTERFACES=
	TM_LOCAL_INTERFACE_IDENTITIES=
	TM_CONFIG_ERROR=0
	config_load trafficmon
	config_list_foreach main local_network resolve_local_network
	config_list_foreach main local_interface append_local_interface
	[ "$TM_CONFIG_ERROR" -eq 0 ] || return 1
	[ -n "$TM_LOCAL_SUBNETS" ] || return 1
	trafficmon_emit_network_signature
}

prefix_signature()
{
	resolve_prefix_signature
}

start_service()
{
	local enabled refresh buffer db_dir generations limit commit period protocols socket debug
	local socket_dir subnet device signature_tmp
	config_load trafficmon
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get refresh main refresh_interval 30
	config_get buffer main netlink_buffer_size 524288
	config_get db_dir main database_directory /etc/trafficmon
	config_get generations main database_generations 10
	config_get limit main database_limit 10000
	config_get commit main commit_interval 86400
	config_get period main accounting_period 1
	config_get protocols main protocol_database /etc/trafficmon/protocols
	config_get socket main socket_path /var/run/trafficmon/trafficmon.sock
	config_get_bool debug main debug 0

	validate_uint refresh "$refresh" 1 86400 || return 1
	validate_uint netlink_buffer_size "$buffer" 1 67108864 || return 1
	validate_uint database_generations "$generations" 1 4096 || return 1
	validate_uint database_limit "$limit" 1 1000000 || return 1
	validate_uint commit_interval "$commit" 1 604800 || return 1
	/usr/sbin/trafficmon --validate-period "$period" >/dev/null 2>&1 || {
		logger -t trafficmon "invalid accounting_period: $period"
		return 1
	}
	validate_path database_directory "$db_dir" || return 1
	validate_path protocol_database "$protocols" || return 1
	validate_path socket_path "$socket" || return 1
	if [ "$protocols" = /etc/trafficmon/protocols ] && [ ! -e "$protocols" ]; then
		mkdir -p /etc/trafficmon || return 1
		cp /usr/share/trafficmon/protocols "$protocols" || return 1
		logger -t trafficmon "initialized protocol database from package defaults"
	fi
	[ -r "$protocols" ] || {
		logger -t trafficmon "protocol database is not readable: $protocols"
		return 1
	}

	TM_LOCAL_SUBNETS=
	TM_LOCAL_INTERFACES=
	TM_LOCAL_INTERFACE_IDENTITIES=
	TM_CONFIG_ERROR=0
	config_list_foreach main local_network resolve_local_network
	config_list_foreach main local_interface append_local_interface
	[ "$TM_CONFIG_ERROR" -eq 0 ] && [ -n "$TM_LOCAL_SUBNETS" ] || {
		logger -t trafficmon "no valid local network prefixes resolved; refusing to start"
		return 1
	}
	signature_tmp="/var/run/trafficmon-network-signature.$$"
	trafficmon_emit_network_signature > "$signature_tmp" || {
		rm -f "$signature_tmp"
		return 1
	}
	mv -f "$signature_tmp" /var/run/trafficmon-network-signature || return 1

	socket_dir="${socket%/*}"
	[ -n "$socket_dir" ] || socket_dir=/
	mkdir -p "$db_dir" "$socket_dir" || return 1

	procd_open_instance
	procd_set_param command /usr/sbin/trafficmon \
		--database-dir "$db_dir" \
		--socket "$socket" \
		--period-rule "$period" \
		--protocol-db "$protocols" \
		--limit "$limit" \
		--generations "$generations" \
		--refresh-seconds "$refresh" \
		--netlink-buffer "$buffer" \
		--commit-seconds "$commit"
	for subnet in $TM_LOCAL_SUBNETS; do
		procd_append_param command --local-subnet "$subnet"
	done
	for device in $TM_LOCAL_INTERFACES; do
		procd_append_param command --local-interface "$device"
	done
	procd_append_param command --static-hostnames /etc/config/dhcp
	procd_append_param command --dhcp-leases /tmp/dhcp.leases
	[ "$debug" -eq 0 ] || procd_append_param command --debug
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/trafficmon "$protocols"
	procd_close_instance
}

append_local_interface()
{
	local device="$1"
	local ifindex
	case "$device" in
		''|*/*)
			logger -t trafficmon "invalid local interface: $device"
			TM_CONFIG_ERROR=1
			return
			;;
	esac
	ifindex="$(cat "/sys/class/net/$device/ifindex" 2>/dev/null)"
	case "$ifindex" in
		''|*[!0-9]*)
			logger -t trafficmon "local interface is unavailable: $device"
			TM_CONFIG_ERROR=1
			return
			;;
	esac
	append TM_LOCAL_INTERFACES "$device"
	append TM_LOCAL_INTERFACE_IDENTITIES "$device:$ifindex"
}

reload_service()
{
	stop
	start
}

service_triggers()
{
	procd_add_reload_trigger trafficmon
}
