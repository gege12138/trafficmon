config trafficmon 'main'
	option enabled '1'
	option refresh_interval '30'
	option netlink_buffer_size '524288'
	option database_directory '/etc/trafficmon'
	option database_generations '10'
	option database_limit '10000'
	option commit_interval '86400'
	option accounting_period '1'
	option protocol_database '/etc/trafficmon/protocols'
	option socket_path '/var/run/trafficmon/trafficmon.sock'
	option debug '0'
	list local_network 'lan'
	# For explicit CIDRs without a logical network, add a trusted LAN device:
	# list local_interface 'br-lan'
