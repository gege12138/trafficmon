{
  "local_networks": ["192.168.0.0/16", "10.0.0.0/8", "2001:db8:1::/64"],
  "protocols": [
    {"name": "HTTPS", "l4_proto": 6, "port": 443},
    {"name": "SSH", "l4_proto": 6, "port": 22},
    {"name": "DNS", "l4_proto": 6, "port": 53},
    {"name": "DNS", "l4_proto": 17, "port": 53}
  ],
  "scenarios": [
    {
      "name": "ipv4_outbound_https_and_ctrzero_delta",
      "flows": [
        {
          "family": 4,
          "l4_proto": 6,
          "orig_src": "192.168.1.10",
          "orig_dst": "1.1.1.1",
          "orig_src_port": 50000,
          "orig_dst_port": 443,
          "original": {"bytes": 1000, "packets": 10},
          "reply": {"bytes": 2000, "packets": 12},
          "mac": "02:00:00:00:00:10",
          "new_connection": true
        },
        {
          "family": 4,
          "l4_proto": 6,
          "orig_src": "192.168.1.10",
          "orig_dst": "1.1.1.1",
          "orig_src_port": 50000,
          "orig_dst_port": 443,
          "original": {"bytes": 300, "packets": 3},
          "reply": {"bytes": 400, "packets": 4},
          "mac": "02:00:00:00:00:10",
          "new_connection": false
        }
      ],
      "expected": [
        {"family": 4, "ip": "192.168.1.10", "mac": "02:00:00:00:00:10", "protocol": "HTTPS", "connections": 1, "download_bytes": 2400, "download_packets": 16, "upload_bytes": 1300, "upload_packets": 13}
      ]
    },
    {
      "name": "ipv4_inbound_ssh",
      "flows": [
        {
          "family": 4,
          "l4_proto": 6,
          "orig_src": "203.0.113.8",
          "orig_dst": "192.168.1.20",
          "orig_src_port": 42000,
          "orig_dst_port": 22,
          "original": {"bytes": 500, "packets": 5},
          "reply": {"bytes": 700, "packets": 7},
          "mac": "02:00:00:00:00:20",
          "new_connection": true
        }
      ],
      "expected": [
        {"family": 4, "ip": "192.168.1.20", "mac": "02:00:00:00:00:20", "protocol": "SSH", "connections": 1, "download_bytes": 500, "download_packets": 5, "upload_bytes": 700, "upload_packets": 7}
      ]
    },
    {
      "name": "ipv6_outbound_dns",
      "flows": [
        {
          "family": 6,
          "l4_proto": 17,
          "orig_src": "2001:db8:1::42",
          "orig_dst": "2001:4860:4860::8888",
          "orig_src_port": 53000,
          "orig_dst_port": 53,
          "original": {"bytes": 120, "packets": 1},
          "reply": {"bytes": 240, "packets": 2},
          "mac": "02:00:00:00:00:42",
          "new_connection": true
        }
      ],
      "expected": [
        {"family": 6, "ip": "2001:db8:1::42", "mac": "02:00:00:00:00:42", "protocol": "DNS", "connections": 1, "download_bytes": 240, "download_packets": 2, "upload_bytes": 120, "upload_packets": 1}
      ]
    },
    {
      "name": "unknown_port_other",
      "flows": [
        {
          "family": 4,
          "l4_proto": 6,
          "orig_src": "10.1.2.3",
          "orig_dst": "198.51.100.4",
          "orig_src_port": 51000,
          "orig_dst_port": 65000,
          "original": {"bytes": 90, "packets": 2},
          "reply": {"bytes": 45, "packets": 1},
          "mac": "02:00:00:00:01:03",
          "new_connection": true
        }
      ],
      "expected": [
        {"family": 4, "ip": "10.1.2.3", "mac": "02:00:00:00:01:03", "protocol": "Other", "connections": 1, "download_bytes": 45, "download_packets": 1, "upload_bytes": 90, "upload_packets": 2}
      ]
    },
    {
      "name": "unknown_mac_is_retained",
      "flows": [
        {
          "family": 4,
          "l4_proto": 17,
          "orig_src": "192.168.2.99",
          "orig_dst": "8.8.8.8",
          "orig_src_port": 54000,
          "orig_dst_port": 53,
          "original": {"bytes": 70, "packets": 1},
          "reply": {"bytes": 140, "packets": 1},
          "mac": null,
          "new_connection": true
        }
      ],
      "expected": [
        {"family": 4, "ip": "192.168.2.99", "mac": null, "protocol": "DNS", "connections": 1, "download_bytes": 140, "download_packets": 1, "upload_bytes": 70, "upload_packets": 1}
      ]
    },
    {
      "name": "lan_to_lan_ignored",
      "flows": [
        {
          "family": 4,
          "l4_proto": 6,
          "orig_src": "192.168.1.2",
          "orig_dst": "192.168.1.3",
          "orig_src_port": 40000,
          "orig_dst_port": 443,
          "original": {"bytes": 999, "packets": 9},
          "reply": {"bytes": 888, "packets": 8},
          "mac": "02:00:00:00:00:02",
          "new_connection": true
        }
      ],
      "expected": []
    },
    {
      "name": "wan_to_wan_ignored",
      "flows": [
        {
          "family": 4,
          "l4_proto": 6,
          "orig_src": "198.51.100.2",
          "orig_dst": "203.0.113.3",
          "orig_src_port": 40000,
          "orig_dst_port": 443,
          "original": {"bytes": 777, "packets": 7},
          "reply": {"bytes": 666, "packets": 6},
          "mac": null,
          "new_connection": true
        }
      ],
      "expected": []
    }
  ]
}
